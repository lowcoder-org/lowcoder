{
  "extends": ["react-app"],
  "plugins": ["only-ascii"],
  "parserOptions": {
    "warnOnUnsupportedTypeScriptVersion": false
  },
  "rules": {
    // "react-hooks/exhaustive-deps": "off"
    //"only-ascii/only-ascii": "error"
    "no-unused-vars": "warn",
    "import/no-unused-modules": [1, {"unusedExports": true}]
  }
}