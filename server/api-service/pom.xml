<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>org.lowcoder</groupId>
	<artifactId>lowcoder-root</artifactId>
	<packaging>pom</packaging>
	<name>lowcoder-root</name>
	<version>${revision}</version>

	<properties>
		<revision>2.7.6</revision>
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<javadoc.disabled>true</javadoc.disabled>
		<deploy.disabled>true</deploy.disabled>
		<source.disabled>true</source.disabled>
		<skipDockerBuild>true</skipDockerBuild>
		<jacoco.version>0.8.14</jacoco.version>
		<!-- declared so that the coverage gate's <skip>${jacoco.skip}</skip> (lowcoder-coverage-report) reads false by
		     default; -Djacoco.skip=true still skips both JaCoCo and the gate -->
		<jacoco.skip>false</jacoco.skip>
		<!-- Empty default for the test JVM arguments: JaCoCo's prepare-agent goals append their agent to it, and the
		     failsafe configuration of lowcoder-server refers to it as @{argLine}, which needs it defined even with
		     -Djacoco.skip=true -->
		<argLine></argLine>
	</properties>

	<profiles>
		<profile>
			<id>cloud</id>
			<properties>
				<profiles.active>cloud</profiles.active>
			</properties>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<build>
				<resources>
					<resource>
						<filtering>false</filtering>
						<directory>src/main/java</directory>
						<excludes>
							<exclude>**/*.java</exclude>
						</excludes>
					</resource>
					<resource>
						<directory>src/main/resources</directory>
						<excludes>
							<exclude>**/selfhost/application*.yml</exclude>
						</excludes>
					</resource>
				</resources>
			</build>
		</profile>
		<profile>
			<id>selfhost</id>
			<properties>
				<profiles.active>selfhost</profiles.active>
			</properties>
			<build>
				<resources>
					<resource>
						<filtering>false</filtering>
						<directory>src/main/java</directory>
						<excludes>
							<exclude>**/*.java</exclude>
						</excludes>
					</resource>
					<resource>
						<directory>src/main/resources</directory>
						<excludes>
							<exclude>**/application*.yml</exclude>
						</excludes>
					</resource>
				</resources>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>2.4.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.1</version>
			</plugin>
			<!-- Code coverage of every module (docs/API_PAYLOAD_TEST_TASKS.md, T11.1): one agent for the unit tests
			     (target/jacoco.exec, surefire) and one for the integration tests (target/jacoco-it.exec, failsafe), and a
			     report of each per module (target/site/jacoco, target/site/jacoco-it); lowcoder-coverage-report aggregates
			     them. Lombok-generated methods carry @lombok.Generated (lombok.config), which JaCoCo leaves out.
			     Limits: only lowcoder-server has integration tests (failsafe), so only it has a jacoco-it report; a module's
			     own report counts only that module's tests, while the aggregate counts a class as covered by the tests of any
			     module that ran it; builds without tests (-DskipTests, the Docker build) attach the agent but write no data,
			     and -Djacoco.skip=true attaches none. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-integration</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>report-integration</id>
						<goals>
							<goal>report-integration</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
					<configuration>
						<source>${java.version}</source>
						<target>${java.version}</target>
						<compilerArgs>
							<arg>-parameters</arg>
						</compilerArgs>
					</configuration>
				</plugin>

				<plugin>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>3.6.0</version>
					<configuration>
						<descriptors>
							<descriptor>src/assembly/bin.xml</descriptor>
						</descriptors>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

	</build>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.lowcoder</groupId>
				<artifactId>lowcoder-sdk</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.lowcoder</groupId>
				<artifactId>lowcoder-infra</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.lowcoder</groupId>
				<artifactId>lowcoder-domain</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.lowcoder</groupId>
				<artifactId>lowcoder-plugins</artifactId>
				<version>${revision}</version>
			</dependency>
			<dependency>
				<groupId>org.lowcoder</groupId>
				<artifactId>lowcoder-server</artifactId>
				<version>${revision}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<modules>
		<module>lowcoder-dependencies</module>
		<module>lowcoder-sdk</module>
		<module>lowcoder-infra</module>
		<module>lowcoder-domain</module>
		<module>lowcoder-plugins</module>
		<module>lowcoder-server</module>
		<!-- last: it aggregates the coverage of every module above -->
		<module>lowcoder-coverage-report</module>
	</modules>

</project>
