    <build>
        <plugins>
            <!-- Publishes the shared JSON-contract test helpers (org.lowcoder.sdk.contract) as a test-jar, so the other
                 modules' payload tests use one copy of them (docs/API_PAYLOAD_TEST_PLAN.md §3.2, owner-approved), and
                 the two test helpers other modules' tests import, JsonFileReader and ConfigCenterForTest (moved here
                 from src/main, docs/COVERAGE_GATE_PLAN.md D-3). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <!-- Helpers only: this module's own tests, their inner classes and fixtures stay out. -->
                            <includes>
                                <include>org/lowcoder/sdk/contract/**</include>
                                <include>org/lowcoder/sdk/test/JsonFileReader*.class</include>
                                <include>org/lowcoder/sdk/config/dynamic/ConfigCenterForTest*.class</include>
                            </includes>
                            <!-- only the contract package's own tests: ConfigCenterForTest also ends in "Test" -->
                            <excludes>
                                <exclude>org/lowcoder/sdk/contract/**/*Test.class</exclude>
                                <exclude>org/lowcoder/sdk/contract/**/*Test$*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

